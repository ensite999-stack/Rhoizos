# Set these in the PHP-FPM pool / container environment (not in public files).
RHOIZOS_STATE_DIR=/var/lib/rhoizos
RHOIZOS_DOMAIN_PRODUCT_ID=
RHOIZOS_NOWPAYMENTS_GATEWAY_ID=
RHOIZOS_SUPPORT_EMAIL=
RHOIZOS_PGP_PUBLIC_KEY_FILE=
# Enable only after sandbox / controlled end-to-end acceptance.
RHOIZOS_LIVE_PAYMENTS=0
RHOIZOS_LIVE_REGISTRATION=0
# Store Spaceship API key + secret and NOWPayments API key + IPN secret
# in FOSSBilling's server-side registrar / payment adapter configuration.
