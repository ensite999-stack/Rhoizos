RHOIZOS_APP_URL=https://example.com
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
CRON_SECRET=

# 32 random bytes, base64 encoded. Used to encrypt EPP/Auth codes at rest.
RHOIZOS_DATA_KEY=

RHOIZOS_TLD_PRICES_JSON={"com":{"register":9.08,"renew":10.18,"transfer":9.68},"net":{"register":11.40,"renew":11.40,"transfer":11.40},"org":{"register":6.85,"renew":11.59,"transfer":11.29},"io":{"register":31.98,"renew":51.75,"transfer":51.75}}

# Registrar credentials for availability, pricing, registration and domain management.
NAMESILO_API_KEY=
# Optional verified registrar payment method used when account funds are insufficient.
NAMESILO_PAYMENT_ID=

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Payment-processing fee allowance used to gross up customer prices. 0.015 = 1.5%.
RHOIZOS_PAYMENT_FEE_RATE=0.015

RESEND_API_KEY=
RHOIZOS_EMAIL_FROM="Rhoizos <no-reply@rhoizos.com>"

RHOIZOS_LIVE_PAYMENTS=0
RHOIZOS_LIVE_REGISTRATION=0
# Enables registrar-funded drop-catching attempts. Caught domains are billed to the customer before delivery.
RHOIZOS_LIVE_DROPCATCH=0
RHOIZOS_SUPPORT_EMAIL=

# One-time secret used only to create the first /admin account.
RHOIZOS_ADMIN_BOOTSTRAP_TOKEN=
