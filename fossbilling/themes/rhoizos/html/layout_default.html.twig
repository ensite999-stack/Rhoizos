<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta property="bb:url" content="{{ constant('SYSTEM_URL') }}">
    <meta property="bb:client_area" content="{{ '/'|link }}">
    <meta name="csrf-token" content="{{ CSRFToken }}">
    <meta name="theme-color" content="#090f19">
    <title>Rhoizos — {% block meta_title %}Your domain. Your world.{% endblock %}</title>
    {{ encore_entry_link_tags('huraga') }}
    <link rel="stylesheet" href="{{ constant('SYSTEM_URL') }}rhoizos-assets/style.css">
    {{ 'Api/API.js'|library_url|script_tag }}
    {{ encore_entry_script_tags('huraga') }}
    {% block head %}{% endblock %}
    {% block js %}{% endblock %}
</head>
<body>
{% block body %}
<header class="site-header">
    <a class="brand" href="{{ '/rhoizos'|link }}#search" aria-label="Rhoizos home">
        <span class="mark"><img src="{{ constant('SYSTEM_URL') }}rhoizos-assets/assets/rhoizos-mark.svg" alt=""></span>
        <span>Rhoizos</span>
    </a>
    <nav class="desktop-links" aria-label="Primary">
        <a href="{{ '/rhoizos'|link }}#search">Search</a>
        <a href="{{ '/rhoizos'|link }}#transfer">Transfer</a>
        <a href="{{ '/rhoizos'|link }}#rdap">RDAP</a>
        <a href="{{ '/rhoizos'|link }}#domains">My domains</a>
    </nav>
    <nav class="nav-actions" aria-label="Account">
        <a href="{{ '/rhoizos'|link }}#cart" aria-label="Cart">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.2 10.5h10.9L21 7H6M9 20h.01M18 20h.01"/></svg>
        </a>
        <a href="{% if client %}{{ '/rhoizos'|link }}#domains{% else %}{{ '/rhoizos'|link }}#login{% endif %}" aria-label="{% if client %}Account{% else %}Log in{% endif %}">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg>
        </a>
        <button id="native-menu-toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label="Menu">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
        </button>
    </nav>
</header>

<section id="menu" hidden>
    <div class="menu-panel">
        <div class="menu-head">
            <span>Rhoizos</span>
            <button type="button" class="menu-close" aria-label="Close menu">Close</button>
        </div>
        <div class="menu-grid">
            <div>
                <span>Services</span>
                <a href="{{ '/rhoizos'|link }}#search">Domain search</a>
                <a href="{{ '/rhoizos'|link }}#transfer">Transfer in</a>
                <a href="{{ '/rhoizos'|link }}#rdap">RDAP lookup</a>
            </div>
            <div>
                <span>Domains</span>
                <a href="{{ '/rhoizos'|link }}#domains">My domains</a>
                <a href="{{ '/rhoizos'|link }}#dns">DNS management</a>
                <a href="{{ '/rhoizos'|link }}#cart">Checkout</a>
            </div>
            <div>
                <span>Account</span>
                {% if client %}
                    <a href="{{ '/rhoizos'|link }}#domains">Account</a>
                    <a href="{{ 'client/logout'|link }}">Log out</a>
                {% else %}
                    <a href="{{ '/rhoizos'|link }}#login">Log in</a>
                    <a href="{{ '/rhoizos'|link }}#signup">Create account</a>
                {% endif %}
                <a href="{{ '/rhoizos'|link }}#policies">Privacy &amp; terms</a>
                <a href="{{ '/rhoizos'|link }}#support">Support</a>
            </div>
        </div>
    </div>
</section>

<main class="wrap page">
    {% block content_before %}{% endblock %}
    {% block content %}{% endblock %}
    {% block content_after %}{% endblock %}
</main>

<footer>
    <div class="wrap footer-grid">
        <div><strong>Rhoizos</strong><p>Your domain. Your world.</p></div>
        <div><a href="{{ '/rhoizos'|link }}#search">Search</a><a href="{{ '/rhoizos'|link }}#transfer">Transfer in</a><a href="{{ '/rhoizos'|link }}#rdap">RDAP</a></div>
        <div><a href="{{ '/rhoizos'|link }}#domains">My domains</a><a href="{{ '/rhoizos'|link }}#policies">Privacy &amp; terms</a><a href="{{ '/rhoizos'|link }}#support">Support</a></div>
        <div class="footer-meta">Domains, transfers and DNS.<br>Nothing else competing for attention.</div>
    </div>
    <div class="wrap footer-bottom">© {{ now|date('Y') }} Rhoizos</div>
</footer>
{% endblock %}

<div class="toast-container position-fixed bottom-0 end-0 p-3"></div>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const toggle = document.getElementById('native-menu-toggle');
    const panel = document.getElementById('menu');
    if (!toggle || !panel) return;
    toggle.addEventListener('click', function () {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
        panel.hidden = open;
    });
    const close = panel.querySelector('.menu-close');
    if (close) close.addEventListener('click', function () { panel.hidden = true; toggle.setAttribute('aria-expanded','false'); });
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !panel.hidden) {
            panel.hidden = true;
            toggle.setAttribute('aria-expanded', 'false');
            toggle.focus();
        }
    });
});
</script>
</body>
</html>
